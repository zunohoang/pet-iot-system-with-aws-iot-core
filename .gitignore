# =====================================================================
# IoT Smart Home — Root .gitignore
# Covers: ESP-IDF firmware, Node.js Lambda, React Native Expo, Terraform
# =====================================================================


# ─────────────────────────────────────────────
# Secrets & Certificates (NEVER commit these)
# ─────────────────────────────────────────────
*.pem
!device/switch/main/root_ca.pem
!device/sensor/main/root_ca.pem
*.key
*.crt
*.p12
*.p8
*.pfx
*.cer
*.der
device/certs/
infra/modules/processing/zips/


# ─────────────────────────────────────────────
# Environment / Config
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
!**/.env.example
*.local


# ─────────────────────────────────────────────
# ESP-IDF (device/switch + device/sensor)
# ─────────────────────────────────────────────
build/
sdkconfig
sdkconfig.old
sdkconfig.defaults.*
.idf_build/
managed_components/
dependencies.lock
.menuconfig.lock
# ESP-IDF generated partition table & bootloader
partition_table/
bootloader/
# Flash encryption & NVS keys (critical secrets)
nvs_partition_gen/
*.bin.enc
flash_encryption_key.bin


# ─────────────────────────────────────────────
# Node.js (backend Lambda functions)
# ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.npm/
*.tgz
# Lambda deployment packages (generated by Terraform archive_file)
*.zip


# ─────────────────────────────────────────────
# React Native & Expo (mobile-app)
# ─────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
# Native build dirs
ios/
android/
# App signing secrets
*.jks
*.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist
# Metro bundler cache
.metro-health-check*


# ─────────────────────────────────────────────
# Terraform (infra)
# ─────────────────────────────────────────────
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.*
**/crash.log
**/crash.*.log
**/*.tfvars
**/*.tfvars.json
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json


# ─────────────────────────────────────────────
# OS & Editor
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
# VSCode (keep workspace settings if needed, ignore user-specific)
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~


# ─────────────────────────────────────────────
# Cursor IDE (project-specific caches)
# ─────────────────────────────────────────────
.cursor/
.kiro/


# ─────────────────────────────────────────────
# Logs & Temp
# ─────────────────────────────────────────────
*.log
logs/
tmp/
temp/
.cache/
