# Not read by the ESP-IDF build — use as a checklist. Copy values into src/config.h
#
# WiFi
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# Fallback when NVS has no iot_host (set full Trusted User path from the app)
AWS_IOT_ENDPOINT=xxxxxxxx-ats.iot.ap-southeast-1.amazonaws.com
AWS_IOT_PORT=8883

# Must match Terraform template: ${project_name}-SwitchTemplate
PROV_TEMPLATE_NAME=iot-smarthome-SwitchTemplate
