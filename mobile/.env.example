# mobile-app — copy to .env (gitignored) and set values from Terraform + AWS
#
#   cp .env.example .env
#   terraform -chdir=../infra output
#
# For IoT data endpoint: AWS Console → IoT Core → Settings →
#   Data endpoint (use the *-ats.iot... host for WSS, without https://)

EXPO_PUBLIC_AWS_REGION=ap-southeast-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_IDENTITY_POOL_ID=
# REST API: include /v1 if your API Gateway stage is v1, e.g. https://xxxxx.execute-api.../v1
EXPO_PUBLIC_API_BASE_URL=
# Host only, e.g. abcdefghijk-ats.iot.ap-southeast-1.amazonaws.com
EXPO_PUBLIC_IOT_ENDPOINT=
